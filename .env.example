# Connection string MongoDB (mis. MongoDB Atlas). Sertakan nama database di path.
# MONGODB_URI="mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/jadwal_mengajar?retryWrites=true&w=majority"
MONGODB_URI="mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/jadwal_mengajar?retryWrites=true&w=majority"

# Secret untuk menandatangani sesi login. Buat dengan: openssl rand -base64 32
AUTH_SECRET="ganti-dengan-string-acak-panjang"

# Akun superadmin yang dibuat oleh `npm run seed`
SEED_SUPERADMIN_USERNAME="superadmin"
SEED_SUPERADMIN_PASSWORD="ganti-password-kuat"
SEED_SUPERADMIN_NAME="Super Administrator"
